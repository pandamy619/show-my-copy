// Build settings every target shares: the app, its tests and the Control Center widget to come. The project's
// Debug and Release configurations are based on this file, so a new target inherits it. Settings a target writes
// into the project file override these: a new target from an Xcode template comes with its own Swift version,
// concurrency settings, deployment target and sandbox settings, so delete those from it, and override only with a
// reason (see Tests.xcconfig).

// Swift 6 with complete concurrency checking. Warnings fail the build.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// Pinned to what this project was written for. Templates of Xcode 26 turn approachable concurrency on and make
// code main-actor isolated by default; code shared with a target made from one must not change meaning there.
SWIFT_APPROACHABLE_CONCURRENCY = NO
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated

MACOSX_DEPLOYMENT_TARGET = 15.0

// Sandboxed and hardened, with no network access in either direction (SECURITY.md). Do not change these.
// scripts/check_security.py checks the values every shipped target ends up with.
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_INCOMING_NETWORK_CONNECTIONS = NO
ENABLE_OUTGOING_NETWORK_CONNECTIONS = NO

// Xcode signs a build it cannot sign with a team "to run locally" and then adds com.apple.security.get-task-allow,
// which lets a debugger attach. A Release build must never carry it (`make security` rejects it). Turning the
// injection off also drops the entitlements Xcode builds from ENABLE_APP_SANDBOX, so the app's entitlements are
// spelled out in Config/ShowMyCopy.entitlements (CODE_SIGN_ENTITLEMENTS on the app target).
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

// One version for the app and everything it embeds: an app extension must match its app's version.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
